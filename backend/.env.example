# Domain served by Caddy with automatic HTTPS (DNS A/AAAA record must point to this server).
DOMAIN=api.example.com

# anthropic | openai | mock
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=replace_me
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_TIMEOUT_SECONDS=90

# Signs device tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=replace_with_64_hex_characters
TOKEN_TTL_DAYS=30

# Limits
MAX_IMAGE_BYTES=3000000
ANALYZE_PER_HOUR=30
ANALYZE_PER_DAY=150
RECIPES_PER_HOUR=20
REGISTER_PER_HOUR_PER_IP=10
TRUST_PROXY_HEADERS=true
